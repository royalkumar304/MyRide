# ==============================================================================
# MYRIDE MOBILE APP (.env.example)
# Copy this file to .env or .env.local to configure your environment.
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API BASE URL (Expo Public Environment Variable)
# ------------------------------------------------------------------------------
# For Expo apps, variables prefixed with EXPO_PUBLIC_ are embedded into the bundle.

# [Option A: Physical Android / iOS Phone on Local Wi-Fi]
# Replace 192.168.x.x with your computer's local Wi-Fi IP address (run `ipconfig` on Windows).
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api/v1

# [Option B: Android Emulator (Android Studio)]
# 10.0.2.2 is the special virtual loopback interface pointing to the host machine.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1

# [Option C: iOS Simulator / Web Browser]
# EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# [Option D: Production Environment]
# EXPO_PUBLIC_API_URL=https://api.myride.in/api/v1


# ==============================================================================
# ⚠️ IMPORTANT GUIDE: ACCESSING LOCAL BACKEND FROM PHYSICAL ANDROID DEVICES
# ==============================================================================
# "localhost" or "127.0.0.1" on a physical phone refers to the phone hardware itself,
# NOT your development computer! If your app tries to call http://localhost:5000
# from a physical phone, the request will immediately fail (Connection Refused).
#
# Follow either of these two methods to connect your phone to your PC's backend:
#
# METHOD 1: Wi-Fi LAN IP (Wireless - Recommended)
#   1. Connect your phone and your PC to the SAME Wi-Fi network.
#   2. On your Windows PC, open PowerShell and run:
#        ipconfig
#      Find the "IPv4 Address" under your active Wi-Fi adapter (e.g. 192.168.1.45).
#   3. In your .env file, set:
#        EXPO_PUBLIC_API_URL=http://192.168.1.45:5000/api/v1
#   4. Ensure Windows Firewall allows incoming connections on port 5000.
#   5. Restart your Expo server: `npx expo start --clear`
#
# METHOD 2: USB Cable via ADB Reverse (Wired - Fastest & Zero Firewall issues)
#   1. Connect your Android phone to your PC via USB cable.
#   2. Enable "USB Debugging" in Developer Options on your phone.
#   3. Run the following command in terminal:
#        adb reverse tcp:5000 tcp:5000
#   4. This routes any request sent to localhost:5000 on your phone directly
#      to port 5000 on your PC!
#   5. You can now use:
#        EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
# ==============================================================================


# ------------------------------------------------------------------------------
# 2. Third-Party Services & Integrations
# ------------------------------------------------------------------------------

# Google Maps Platform (Android & iOS SDK)
GOOGLE_MAPS_API_KEY=AIzaSy_SAMPLE_GOOGLE_MAPS_KEY

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=rzp_test_MyRideProd2026

# Firebase Cloud Messaging & Push Notifications
FIREBASE_API_KEY=AIzaSy_SAMPLE_FIREBASE_KEY
FIREBASE_PROJECT_ID=myride-mobility
FIREBASE_MESSAGING_SENDER_ID=1092837465
FIREBASE_APP_ID=1:1092837465:web:abcdef123456

# Cloudinary Storage for Vehicle & Inspection Photos
CLOUDINARY_CLOUD_NAME=myride-assets
CLOUDINARY_PRESET=vehicle_documents
