# ==========================================
# MYRIDE BACKEND CONFIGURATION (.env.example)
# ==========================================
PORT=5000
NODE_ENV=development

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/myride
REDIS_URL=redis://localhost:6379

# Authentication (Change in production to a long random 64+ char secret)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
EXPOSE_DEV_OTP=true

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# SMS Gateway (Fast2SMS / Twilio)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=myride-assets
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Webhook Secret (Dedicated secret configured in Razorpay Dashboard)
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_TO_A_RANDOM_WEBHOOK_SECRET
